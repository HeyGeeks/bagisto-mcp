{
    "name": "heygeeks/bagisto-mcp",
    "description": "Bagisto MCP Server for LLM Integration",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "HeyGeeks",
            "email": "dev@heygeeks.in"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0",
        "mcp/sdk": "^0.3.0"
    },
    "autoload": {
        "psr-4": {
            "HeyGeeks\\BagistoMCP\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HeyGeeks\\BagistoMCP\\MCPServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
